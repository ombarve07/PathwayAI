# PATHWAY AI Configuration

# Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Database (Default uses local SQLite; uncomment MySQL for production/MySQL service)
DATABASE_URL=sqlite:///./pathway_ai.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pathway_ai?charset=utf8mb4

# Authentication
JWT_SECRET=supersecretjwtkey_pathwayai_replace_in_production_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Pricing (Configurable in INR)
REPORT_PRICE_INR=99.0
PREMIUM_PRICE_INR=999.0

# Razorpay Test Credentials (replace with your keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret_key

# Admin Seed
DEFAULT_ADMIN_EMAIL=admin@pathway.ai
DEFAULT_ADMIN_PASSWORD=Admin@12345
